# Copy to .env and fill in (or export directly in your shell/host's env settings).

# Get a key at https://console.anthropic.com/ -- without it, reports still
# generate using the built-in rule-based narrative, just without the
# personalized AI-written summary.
ANTHROPIC_API_KEY=

# Any random long string -- used to sign Flask's session cookie for flash messages.
SECRET_KEY=change-me-to-something-random

# Password for /admin (leads + recent scans, includes real email addresses).
# Leave unset to disable admin login entirely -- it does NOT fall back to a
# default password.
ADMIN_PASSWORD=

# Turns on /admin/active-scan: real, non-destructive attack-detection probes
# (reflected XSS, error-based SQLi, SSTI, path traversal, OS command
# injection, open redirect, a tiny default-credential check), not passive
# checks. Only run this against sites you have explicit written
# authorization to test -- unauthorized use is a criminal offense in most
# jurisdictions regardless of intent. Off by default; leave it that way
# unless you specifically need it, and even then it's still gated behind
# admin login + a per-target typed confirmation. See the README.
ACTIVE_TESTING_ENABLED=0

# active-scan's discovery step falls back to rendering the page in headless
# Chromium (see js_discovery.py) when the fast HTML crawl finds nothing --
# needed for React/Vue/Next.js-style sites whose real forms only exist
# after client-side JS runs. On by default; set to 0 to turn it off (e.g.
# if the host doesn't have the memory budget for a browser process on top
# of everything else).
ACTIVE_SCAN_JS_DISCOVERY=1

# Emails a lead their report (link + PDF) automatically when they submit
# the "send me the fix plan" form. Off by default -- leave SMTP_USERNAME
# unset and lead capture still works exactly the same, it just won't also
# send an email. For Gmail: create an App Password (not your real password)
# at myaccount.google.com/apppasswords -- needs 2-Step Verification on.
# Set these directly in Render's env var settings (or here for local dev),
# never share an app password in chat with anyone, including Claude.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Defaults to SMTP_USERNAME if unset.
SMTP_FROM=

# Set to 1 to enable Flask's debug mode (auto-reload + interactive debugger).
# Leave unset/0 in any deployment -- with the interactive debugger, this
# allows remote code execution if the server is reachable. Local dev only.
FLASK_DEBUG=0

# Scan targets are validated to block private/internal addresses (SSRF
# protection) so this can't be used to probe your own infrastructure. Set to
# 1 only for local demoing against test_target.py, which serves on localhost.
SITEGUARD_ALLOW_PRIVATE_TARGETS=0
